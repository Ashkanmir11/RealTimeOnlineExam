@using OnlineExam.Ui.DTO.Question
@using OnlineExam.Ui.DTO.TrueOrFalseAnswers
@using OnlineExam.Ui.DTO.DescriptiveAnswers
@page "/studentAnswer/{ExamId:int}"
@inject ExamServices _examServices;
<h3>StudentAnswer</h3>
<p style="color:red">توجه نمرات وارد شده توسط هوش مصنوعی نمره گذاری شده و امکان اشتباه وجود دارد.</p>
@{
    if (result.Data == null || result.Data.Count == 0)
    {
        <p>پاسخی یافت نشد.</p>
    }
    else
    {
        <p>نمره کامل دانشجو:@totalScore</p>
        foreach (var question in result.Data)
        {
            <div style="border:2px solid black">
                <label for="questiontext">متن سوال:</label>
                <p id="questiontext">@question.QuestionText</p>

                <label for="questionScore">نمره سوال:</label>
                <p id="questionScore">@question.TotalScore</p>
                @{
                    if (question.TrueOrFalseQuestion != null)
                    {
                        <label for="correctAnswer">پاسخ صحیح:</label>
                        <InputCheckbox @bind-Value="question.TrueOrFalseQuestion.CorrectAnswer" id="correctAnswer" disabled />
                        if (question.TrueOrFalseQuestion.Answer == null)
                        {
                            <p>دانشجو پاسخی نداده است.</p>
                        }
                        else
                        {
                            <label for="studentAnswer">پاسخ دانشجو:</label>
                            <InputCheckbox @bind-Value="question.TrueOrFalseQuestion.Answer.StudentAnswer" id="studentAnswer" disabled />
                            <label for="studentScore">نمره دانشجو:</label>
                            <input Value="@question.TrueOrFalseQuestion.Answer.StudentScore" type="text" id="studentScore" @onchange="arg=>ChangeScore(arg,question.Id,QuestionType.TrueOrFalse)" />
                        }

                    }
                    if (question.DescriptiveQuestion != null)
                    {
                        <label for="correctAnswer">پاسخ صحیح:</label>
                        <InputTextArea @bind-Value="question.DescriptiveQuestion.CorrectAnswer" id="correctAnswer" disabled />

                        if (question.DescriptiveQuestion.Answer == null)
                        {
                            <p>دانشجو پاسخی نداده است.</p>
                        }
                        else
                        {
                            <label for="studentAnswer">پاسخ دانشجو:</label>
                            <InputTextArea @bind-Value="question.DescriptiveQuestion.Answer.StudentAnswer" id="studentAnswer" disabled />
                            <label for="studentScore">نمره دانشجو:</label>
                            <input Value="@question.DescriptiveQuestion.Answer.StudentScore" type="text" id="studentScore" @onchange="arg=>ChangeScore(arg,question.Id,QuestionType.Descripite)" />
                        }
                    }
                }
            </div>

        }
    }
}
<ErrorComponent Errors="Errors"></ErrorComponent>
@code {
    [Parameter]
    public int ExamId { get; set; }
    [SupplyParameterFromQuery]
    public string? StudentId { get; set; }
    PaginateResponse<GetQuestionWithAnswerDTO> result = new PaginateResponse<GetQuestionWithAnswerDTO>();
    decimal totalScore;
    protected override async Task OnInitializedAsync()
    {
        await GetData();
        ShowTotalScore();
        await base.OnInitializedAsync();
    }
    private async Task GetData()
    {
        var response = await _examServices.GetStudentQuestionsAndAnswer(ExamId, StudentId, GetDefultPaginate());
        if (!response.IsSuccess)
        {
            SetErrors(response.Errors);
        }
        else
        {
            result.Data = response.Data.Data;
        }
    }
    private void ShowTotalScore()
    {
        totalScore = 0;
        foreach (var question in result.Data)
        {
            if (question.TrueOrFalseQuestion != null)
            {
                totalScore += question.TrueOrFalseQuestion.Answer == null ? 0 : question.TrueOrFalseQuestion.Answer.StudentScore;
            }
            if(question.DescriptiveQuestion!=null)
            {
                totalScore += question.DescriptiveQuestion.Answer == null ? 0 : question.DescriptiveQuestion.Answer.StudentScore;
            }
        }
        StateHasChanged();
    }
    #region true or flase answer
    private async Task ChangeScore(ChangeEventArgs arg, int questionId, QuestionType questionType)
    {
        try
        {
            var value = arg.Value.ToString();
            if (value.Contains("/"))
            {
                value = value.Replace("/", ".");
            }
            decimal score = Convert.ToDecimal(value);
            var quesiton = result.Data.Where(e => e.Id == questionId).FirstOrDefault();
            switch (questionType)
            {
                case QuestionType.TrueOrFalse:
                    {
                        if (quesiton.TrueOrFalseQuestion.Answer != null)
                        {
                            quesiton.TrueOrFalseQuestion.Answer.StudentScore = score;
                            var answerId = quesiton.TrueOrFalseQuestion.Answer.Id;
                            await GradeTrueOrFalseAnswer(answerId, score);
                        }
                        break;
                    }
                case QuestionType.Descripite:
                    {
                        if(quesiton.DescriptiveQuestion.Answer!=null)
                        {
                            quesiton.DescriptiveQuestion.Answer.StudentScore = score;
                            var answerId = quesiton.DescriptiveQuestion.Answer.Id;
                            await GradeeDescritiveAnswer(answerId, score);
                        }
                        break;
                    }
            }


        }
        catch (Exception ex)
        {
            SetErrors("مقدار عددی معتبر وارد کنید.");
        }
    }
    private async Task GradeTrueOrFalseAnswer(int answerId, decimal score)
    {
        var newScore = new UpdateTrueOrFalseAnswerTeacherDTO()
            {
                ExamId = ExamId,
                StudentScore = score
            };
        var response = await _examServices.GradeTrueOrFalseQuestion(newScore, answerId);
        if (!response.IsSuccess)
        {
            SetErrors(response.Errors);
        }
        else
        {
            ShowTotalScore();
            await _jsRuntime.InvokeVoidAsync("alert", "نمره ثبت شد.");
        }
    }
    private async Task GradeeDescritiveAnswer(int answerId, decimal score)
    {
        var newScore = new UpdateDescriptiveAnswersTeacherDTO()
            {
                ExamId = ExamId,
                StudentScore = score
            };
        var response = await _examServices.GradeDescriptiveQuestion(newScore, answerId);
        if (!response.IsSuccess)
        {
            SetErrors(response.Errors);
        }
        else
        {
            ShowTotalScore();
            await _jsRuntime.InvokeVoidAsync("alert", "نمره ثبت شد.");
        }
    }
    #endregion

}
