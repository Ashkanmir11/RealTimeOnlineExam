@using OnlineExam.Ui.DTO.Question
@using OnlineExam.Ui.DTO.TrueOrFalseAnswers
@using OnlineExam.Ui.DTO.DescriptiveAnswers
@using OnlineExam.Ui.DTO.MultipleChoiceAnswers
@using OnlineExam.Ui.Components.Exam
@page "/studentAnswer/{ExamId:int}"
@inject ExamServices _examServices;
<div class="student-answer-page">

    <header class="student-answer-header">
        <div>
            <h3>تصحیح پاسخ‌های دانش‌آموز</h3>
            <p>
                پاسخ‌ها، نمرات و جزئیات آزمون دانش‌آموز را بررسی و در صورت نیاز اصلاح کنید.
            </p>
        </div>
    </header>

    <div class="student-answer-ai-warning">
        <span class="student-answer-warning-icon">!</span>

        <p>
            توجه: نمرات واردشده توسط هوش مصنوعی نمره‌گذاری شده‌اند و احتمال خطا وجود دارد.
            لطفاً پیش از ثبت نهایی، نمرات را بررسی کنید.
        </p>
    </div>

    <div class="student-answer-layout">

        <main class="student-answer-content">
            @{
                if (DataLoaded)
                {
                    if (Result.Data == null || Result.Data.Count == 0)
                    {
                        <div class="student-answer-empty-state">
                            <div class="student-answer-empty-icon">📝</div>
                            <h4>پاسخی یافت نشد</h4>
                            <p>دانش‌آموز برای این آزمون پاسخی ثبت نکرده است.</p>
                        </div>
                    }
                    else
                    {
                        <div class="student-answer-total-score">
                            <span>نمره کامل دانش‌آموز</span>
                            <strong>@TotalScore</strong>
                        </div>

                        <div class="student-answer-questions">
                            @foreach (var question in Result.Data)
                            {
                                <section class="student-answer-question-card">

                                    <div class="student-answer-question-header">
                                        <span class="student-answer-question-title">
                                            سؤال
                                        </span>

                                        <span class="student-answer-question-score">
                                            نمره سؤال: @question.TotalScore
                                        </span>
                                    </div>

                                    <div class="student-answer-question-body">
                                        <span class="student-answer-field-label">
                                            متن سؤال
                                        </span>

                                        <p class="student-answer-question-text">
                                            @question.QuestionText
                                        </p>
                                    </div>

                                    @{
                                        if (question.TrueOrFalseQuestion != null)
                                        {
                                            <div class="student-answer-answer-grid">

                                                <div class="student-answer-answer-box">
                                                    <span class="student-answer-field-label">
                                                        پاسخ صحیح
                                                    </span>

                                                    <label class="student-answer-checkbox-value">
                                                        <InputCheckbox class="student-answer-checkbox"
                                                                       @bind-Value="question.TrueOrFalseQuestion.CorrectAnswer"
                                                                       disabled />

                                                        <span>
                                                            @(question.TrueOrFalseQuestion.CorrectAnswer ? "صحیح" : "غلط")
                                                        </span>
                                                    </label>
                                                </div>

                                                @if (question.TrueOrFalseQuestion.Answer == null)
                                                {
                                                    <div class="student-answer-no-response">
                                                        دانش‌آموز پاسخی نداده است.
                                                    </div>
                                                }
                                                else
                                                {
                                                    <div class="student-answer-answer-box">
                                                        <span class="student-answer-field-label">
                                                            پاسخ دانش‌آموز
                                                        </span>

                                                        <label class="student-answer-checkbox-value">
                                                            <InputCheckbox class="student-answer-checkbox"
                                                                           @bind-Value="question.TrueOrFalseQuestion.Answer.StudentAnswer"
                                                                           disabled />

                                                            <span>
                                                                @(question.TrueOrFalseQuestion.Answer.StudentAnswer ? "صحیح" : "غلط")
                                                            </span>
                                                        </label>
                                                    </div>

                                                    <div class="student-answer-score-box">
                                                        <label class="student-answer-field-label"
                                                               for="@($"trueFalseScore-{question.Id}")">
                                                            نمره دانش‌آموز
                                                        </label>

                                                        <input class="student-answer-score-input"
                                                               value="@question.TrueOrFalseQuestion.Answer.StudentScore"
                                                               type="text"
                                                               id="@($"trueFalseScore-{question.Id}")"
                                                               @onchange="arg => ChangeScore(arg, question.Id, QuestionType.TrueOrFalse)" />
                                                    </div>
                                                }

                                            </div>
                                        }

                                        if (question.DescriptiveQuestion != null)
                                        {
                                            <div class="student-answer-answer-grid">

                                                <div class="student-answer-answer-box student-answer-answer-box-full">
                                                    <label class="student-answer-field-label"
                                                           for="@($"correctDescriptiveAnswer-{question.Id}")">
                                                        پاسخ صحیح
                                                    </label>

                                                    <InputTextArea class="student-answer-textarea"
                                                                   @bind-Value="question.DescriptiveQuestion.CorrectAnswer"
                                                                   id="@($"correctDescriptiveAnswer-{question.Id}")"
                                                                   disabled />
                                                </div>

                                                @if (question.DescriptiveQuestion.Answer == null)
                                                {
                                                    <div class="student-answer-no-response">
                                                        دانش‌آموز پاسخی نداده است.
                                                    </div>
                                                }
                                                else
                                                {
                                                    <div class="student-answer-answer-box student-answer-answer-box-full">
                                                        <label class="student-answer-field-label"
                                                               for="@($"studentDescriptiveAnswer-{question.Id}")">
                                                            پاسخ دانش‌آموز
                                                        </label>

                                                        <InputTextArea class="student-answer-textarea"
                                                                       @bind-Value="question.DescriptiveQuestion.Answer.StudentAnswer"
                                                                       id="@($"studentDescriptiveAnswer-{question.Id}")"
                                                                       disabled />
                                                    </div>

                                                    <div class="student-answer-score-box">
                                                        <label class="student-answer-field-label"
                                                               for="@($"descriptiveScore-{question.Id}")">
                                                            نمره دانش‌آموز
                                                        </label>

                                                        <input class="student-answer-score-input"
                                                               value="@question.DescriptiveQuestion.Answer.StudentScore"
                                                               type="text"
                                                               id="@($"descriptiveScore-{question.Id}")"
                                                               @onchange="arg => ChangeScore(arg, question.Id, QuestionType.Descripite)" />
                                                    </div>
                                                }

                                            </div>
                                        }

                                        if (question.MultipleChoiceQuestion != null)
                                        {
                                            <div class="student-answer-answer-grid">

                                                <div class="student-answer-answer-box student-answer-answer-box-full">
                                                    <span class="student-answer-field-label">
                                                        گزینه‌های سؤال
                                                    </span>

                                                    <div class="student-answer-choices">
                                                        @for (int i = 0; i < question.MultipleChoiceQuestion.Choices.Count; i++)
                                                        {
                                                            var index = i + 1;

                                                            <div class="student-answer-choice">
                                                                <span class="student-answer-choice-number">
                                                                    @index
                                                                </span>

                                                                <span>
                                                                    @question.MultipleChoiceQuestion.Choices[i]
                                                                </span>
                                                            </div>
                                                        }
                                                    </div>
                                                </div>

                                                @if (question.MultipleChoiceQuestion.Answer == null)
                                                {
                                                    <div class="student-answer-no-response">
                                                        دانش‌آموز پاسخی نداده است.
                                                    </div>
                                                }
                                                else
                                                {
                                                    <div class="student-answer-answer-box">
                                                        <span class="student-answer-field-label">
                                                            پاسخ دانش‌آموز
                                                        </span>

                                                        <p class="student-answer-selected-choice">
                                                            گزینه
                                                            <strong>
                                                                @question.MultipleChoiceQuestion.Answer.StudentChoice
                                                            </strong>
                                                            :
                                                            @question.MultipleChoiceQuestion.Choices[
                                                             (int)question.MultipleChoiceQuestion.Answer.StudentChoice - 1
                                                             ]
                                                        </p>
                                                    </div>

                                                    <div class="student-answer-score-box">
                                                        <label class="student-answer-field-label"
                                                               for="@($"multipleChoiceScore-{question.Id}")">
                                                            نمره دانش‌آموز
                                                        </label>

                                                        <input class="student-answer-score-input"
                                                               value="@question.MultipleChoiceQuestion.Answer.StudentScore"
                                                               type="text"
                                                               id="@($"multipleChoiceScore-{question.Id}")"
                                                               @onchange="arg => ChangeScore(arg, question.Id, QuestionType.MultipleChoice)" />
                                                    </div>
                                                }

                                            </div>
                                        }
                                    }

                                </section>
                            }
                        </div>
                    }
                }
                else
                {
                    <LoadingComponent></LoadingComponent>
                }
            }
        </main>

        <aside class="student-answer-log-sidebar">
            <ExamLogComponent ExamId="@ExamId"
                              StudentId="@StudentId">
            </ExamLogComponent>
        </aside>

    </div>

    <ErrorComponent Errors="@Errors"></ErrorComponent>

</div>


@code {
    [Parameter]
    public int ExamId { get; set; }
    [SupplyParameterFromQuery]
    public required string StudentId { get; set; }
    PaginateResponse<GetQuestionWithAnswerDTO> Result = new PaginateResponse<GetQuestionWithAnswerDTO>();
    decimal TotalScore;
    protected override async Task OnInitializedAsync()
    {
        await GetData();
        ShowTotalScore();
        await base.OnInitializedAsync();
    }
    private async Task GetData()
    {
        var response = await _examServices.GetStudentQuestionsAndAnswer(ExamId, StudentId, GetDefultPaginate());
        DataLoaded = true;
        if (!response.IsSuccess)
        {
            SetErrors(response.Errors);
        }
        else
        {
            Result.Data = response.Data.Data;
        }
        StateHasChanged();
    }
    private void ShowTotalScore()
    {
        TotalScore = 0;
        foreach (var question in Result.Data)
        {
            if (question.TrueOrFalseQuestion != null)
            {
                TotalScore += question.TrueOrFalseQuestion.Answer == null ? 0 : question.TrueOrFalseQuestion.Answer.StudentScore;
            }
            if (question.DescriptiveQuestion != null)
            {
                TotalScore += question.DescriptiveQuestion.Answer == null ? 0 : question.DescriptiveQuestion.Answer.StudentScore;
            }
            if (question.MultipleChoiceQuestion != null)
            {
                TotalScore += question.MultipleChoiceQuestion.Answer == null ? 0 : question.MultipleChoiceQuestion.Answer.StudentScore;

            }
        }
        StateHasChanged();
    }
    private async Task ChangeScore(ChangeEventArgs arg, int questionId, QuestionType questionType)
    {
        try
        {
            var value = arg.Value.ToString();
            if (value.Contains("/"))
            {
                value = value.Replace("/", ".");
            }
            decimal score = Convert.ToDecimal(value);
            var quesiton = Result.Data.Where(e => e.Id == questionId).FirstOrDefault();
            switch (questionType)
            {
                case QuestionType.TrueOrFalse:
                    {
                        if (quesiton.TrueOrFalseQuestion.Answer != null)
                        {
                            quesiton.TrueOrFalseQuestion.Answer.StudentScore = score;
                            var answerId = quesiton.TrueOrFalseQuestion.Answer.Id;
                            await Grading(answerId, score, QuestionType.TrueOrFalse);
                        }
                        break;
                    }
                case QuestionType.Descripite:
                    {
                        if (quesiton.DescriptiveQuestion.Answer != null)
                        {
                            quesiton.DescriptiveQuestion.Answer.StudentScore = score;
                            var answerId = quesiton.DescriptiveQuestion.Answer.Id;
                            await Grading(answerId, score, QuestionType.Descripite);
                        }
                        break;
                    }
                case QuestionType.MultipleChoice:
                    {
                        if (quesiton.MultipleChoiceQuestion.Answer != null)
                        {
                            quesiton.MultipleChoiceQuestion.Answer.StudentScore = score;
                            var answerId = quesiton.MultipleChoiceQuestion.Answer.Id;
                            await Grading(answerId, score, QuestionType.MultipleChoice);
                        }
                        break;
                    }
            }


        }
        catch (Exception ex)
        {
            SetErrors("مقدار عددی معتبر وارد کنید.");
        }
    }
    private async Task Grading(int answerId, decimal score, QuestionType questionType)
    {
        var response = new CommonResponse<EmptyResponse>();
        switch (questionType)
        {
            case QuestionType.TrueOrFalse:
                {
                    var newScore = new UpdateTrueOrFalseAnswerTeacherDTO()
                        {
                            ExamId = ExamId,
                            StudentScore = score
                        };
                    response = await _examServices.GradeTrueOrFalseQuestion(newScore, answerId);
                    break;
                }
            case QuestionType.Descripite:
                {
                    var newScore = new UpdateDescriptiveAnswersTeacherDTO()
                        {
                            ExamId = ExamId,
                            StudentScore = score
                        };
                    response = await _examServices.GradeDescriptiveQuestion(newScore, answerId);
                    break;
                }
            case QuestionType.MultipleChoice:
                {
                    var newScore = new UpdateMultipleChoiceAnswerTeacherDTO()
                        {
                            ExamId = ExamId,
                            StudentScore = score
                        };
                    response = await _examServices.GradeMultiplechoiceQuestion(newScore, answerId);
                    break;
                }
        }

        if (!response.IsSuccess)
        {
            SetErrors(response.Errors);
        }
        else
        {
            ShowTotalScore();
            await _jsRuntime.InvokeVoidAsync("alert", "نمره ثبت شد.");
        }
    }

}
