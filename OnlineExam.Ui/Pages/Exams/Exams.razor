@using OnlineExam.Ui.DTO.Exam;
@page "/Exams/{ClassId:int}"
@inject ExamServices _examServices;
<div class="exams-page">
    <div class="exams-header">
        <div>
            <h3>آزمون‌ها</h3>
            <p>مدیریت آزمون‌ها، سؤال‌ها و تصحیح پاسخ‌ها</p>
        </div>

        <button class="add-exam-button" @onclick="RedirectToCreateExam">
            افزودن آزمون
        </button>
    </div>

    @if (DataLoaded)
    {
        @if (Result?.Data == null || Result.Data.Count == 0)
        {
            <div class="exams-empty-state">
                <div class="empty-icon">📝</div>
                <h4>آزمونی یافت نشد</h4>
                <p>برای شروع، اولین آزمون خود را ایجاد کنید.</p>

                <button class="add-exam-button" @onclick="RedirectToCreateExam">
                    افزودن آزمون
                </button>
            </div>
        }
        else
        {
            <div class="exams-table-wrapper">
                <table class="exams-table">
                    <thead>
                        <tr>
                            <th>تعداد سؤال</th>
                            <th>نام آزمون</th>
                            <th>توضیحات</th>
                            <th>تاریخ شروع</th>
                            <th>تاریخ پایان</th>
                            <th>میزان مجاز تأخیر</th>
                            <th>اجازه کپی</th>
                            <th>سؤالات درهم</th>
                            <th>لاگ دانشجو</th>
                            <th>عملیات</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var exam in Result.Data)
                        {
                            <tr>
                                <td>
                                    <span class="question-count">@exam.QuestionCount</span>
                                </td>

                                <td class="exam-name">@exam.Name</td>

                                <td class="exam-description" title="@exam.Description">
                                    @exam.Description
                                </td>

                                <td class="date-cell">
                                    @DateHelper.MiladiToShamsi((DateTime)exam.StartDate)
                                </td>

                                <td class="date-cell">
                                    @DateHelper.MiladiToShamsi((DateTime)exam.EndDate)
                                </td>

                                <td>
                                    <span class="delay-badge">@exam.AllowedDelay</span>
                                </td>

                                <td>
                                    <div class="checkbox-cell">
                                        <InputCheckbox disabled @bind-Value="@exam.AllowedCopy" />
                                    </div>
                                </td>

                                <td>
                                    <div class="checkbox-cell">
                                        <InputCheckbox disabled @bind-Value="@exam.RandomQuestions" />
                                    </div>
                                </td>
                                <td>
                                    <div class="checkbox-cell">
                                        <InputCheckbox disabled @bind-Value="@exam.LogStudent" />
                                    </div>
                                </td>
                                <td>
                                    <div class="exam-actions">
                                        <button class="exam-action-button danger"
                                                title="حذف آزمون"
                                                @onclick="() => Delete(exam.Id)">
                                            حذف
                                        </button>

                                        <button class="exam-action-button edit"
                                                title="ویرایش آزمون"
                                                @onclick="() => RedirectToUpdateExam(exam.Id)">
                                            ویرایش
                                        </button>

                                        <button class="exam-action-button questions"
                                                title="مدیریت سوالات"
                                                @onclick="() => RedirectToQuestions(exam.Id)">
                                            سوالات
                                        </button>

                                        <button class="exam-action-button grading"
                                                title="تصحیح سوالات"
                                                @onclick="() => RedirectToExamGrading(exam.Id)">
                                            تصحیح
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }

        <ErrorComponent Errors="@Errors" />

        @if (Result is not null)
        {
            <PaginateComponent CurrentPage="Result.PageNumber"
                               TotalPage="@Result.TotalPage"
                               SelectedPage="@changePage" />
        }
    }
    else
    {
        <LoadingComponent />
    }
</div>

@code {
    [Parameter]
    public int ClassId { get; set; }
    PaginateResponse<GetExamDetailDTO> Result = new PaginateResponse<GetExamDetailDTO>();
    private async void changePage(int selectedPage)
    {
        SetPageNumber(selectedPage);
        await GetData();
    }
    protected override async Task OnInitializedAsync()
    {
        Result.Data = new List<GetExamDetailDTO>();
        await GetData();
        await base.OnInitializedAsync();
    }
    private async Task Delete(int Id)
    {
        var response = await _examServices.DeleteAsync(Id);
        if (!response.IsSuccess)
        {
            SetErrors(response.Errors);
        }
        else
        {
            await GetData();
        }
    }
    private async Task GetData()
    {
        Result = new PaginateResponse<GetExamDetailDTO>();
        var response = await _examServices.GetExamTeacher(ClassId, GetDefultPaginate());
        DataLoaded = true;
        if (!response.IsSuccess)
        {
            SetErrors(response.Errors);
            StateHasChanged();
        }
        else if (response.StatusCode != 204)
        {
            Result = response.Data;
        }
        StateHasChanged();
    }
    #region redirects
    private void RedirectToCreateExam()
    {
        _navigationManager.NavigateTo($"CreateExams/{ClassId}");
    }
    private void RedirectToUpdateExam(int id)
    {
        _navigationManager.NavigateTo($"updateExam/{id}/{ClassId}");
    }
    private void RedirectToQuestions(int id)
    {
        _navigationManager.NavigateTo($"question/{id}");
    }
    private void RedirectToExamGrading(int id)
    {
        _navigationManager.NavigateTo($"examGrading/{ClassId}/{id}");
    }
    #endregion
}
