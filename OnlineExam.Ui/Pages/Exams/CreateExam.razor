@using OnlineExam.Ui.DTO.Exam;
@page "/CreateExams/{ClassId:int}";
@inject ExamServices _examServices;
<EditForm EditContext="@EditContext" OnValidSubmit="@preAddAsync">
    <DataAnnotationsValidator></DataAnnotationsValidator>
    <label for="questionCount">تعداد سوال:</label>
    <InputNumber id="questionCount" @bind-Value="@CreateExamDTO.QuestionCount"></InputNumber>
    <br />

    <label for="examName">نام آزمون:</label>
    <InputText id="examName" @bind-Value="@CreateExamDTO.Name"></InputText>
    <br />

    <label for="examDescription">توضیحات آزمون:</label>
    <InputTextArea id="examDescription" @bind-Value="@CreateExamDTO.Description"></InputTextArea>
    <br />

    <label for="examStartDate">تاریخ شروع:</label>
    <InputPersianDatePicker id="examStartDate" @bind-ValueAsDateTime="CreateExamDTO.StartDate" CalendarType="Calendar.SingleModeJalali" ReadOnly=true></InputPersianDatePicker>
    <br />

    <label for="examEndDate">تاریخ پایان:</label>
    <InputPersianDatePicker id="examEndDate" @bind-ValueAsDateTime="CreateExamDTO.EndDate" CalendarType="Calendar.SingleModeJalali" ReadOnly=true></InputPersianDatePicker>
    <br />

    <label for="examStartTime">ساعت شروع:</label>
    <InputNumber placeholde="دقیقه" id="examStartTime" @bind-Value="@StartTimeMinute"></InputNumber>
    :
    <InputNumber placeholder="ساعت" @bind-Value="@StartTimeHour"></InputNumber>
    <br />

    <label for="examEndTime">ساعت پایان:</label>
    <InputNumber placeholde="دقیقه" id="examEndTime" @bind-Value="@EndTimeMinute"></InputNumber>
    :
    <InputNumber placeholder="ساعت" @bind-Value="@EndTimeHour"></InputNumber>
    <br />

    <label for="examAllowDelay">میزان تاخیر مجاز:</label>
    <InputNumber id="examAllowDelay" @bind-Value="@CreateExamDTO.AllowedDelay"></InputNumber>
    <br />

    <label for="examAllowCopy">اجازه کپی:</label>
    <InputCheckbox id="examAllowCopy" @bind-Value="@CreateExamDTO.AllowedCopy"></InputCheckbox>
    <br />

    <label for="examLogStudent">لاگ کردن دانشجویان:</label>
    <InputCheckbox id="examLogStudent" @bind-Value="@CreateExamDTO.LogStudent"></InputCheckbox>
    <br />

    <label for="examRandomQuestion">سوالات درهم:</label>
    <InputCheckbox id="examRandomQuestion" @bind-Value="@CreateExamDTO.RandomQuestions"></InputCheckbox>
    <br />

    <button type="submit">افزودن</button>
</EditForm>

<ErrorComponent Errors="@Errors"></ErrorComponent>
@code {
    [Parameter]
    public int ClassId { get; set; }

    public EditContext EditContext;
    CreateExamDTO CreateExamDTO = new CreateExamDTO();
    int StartTimeHour;
    int StartTimeMinute;
    int EndTimeHour;
    int EndTimeMinute;

    protected override void OnInitialized()
    {
        EditContext = new EditContext(CreateExamDTO);
        EditContext.OnValidationStateChanged += (sender, args) =>
        {
            var validationErrors = EditContext.GetValidationMessages();
            SetErrors(validationErrors.ToList());
            StateHasChanged();
        };
        base.OnInitialized();
    }
    private async void preAddAsync()
    {
        CreateExamDTO.ClassId = ClassId;
        if (StartTimeHour > 23 || StartTimeHour < 0 || StartTimeMinute > 59 || StartTimeMinute < 0 ||
        EndTimeHour > 23 || EndTimeHour < 0 || EndTimeMinute > 59 || EndTimeMinute < 0)
        {
            SetErrors("ساعت انتخابی درست نیست.");
            StateHasChanged();
        }
        else
        {
            Errors.Clear();
            CreateExamDTO.StartDate = new DateTime(CreateExamDTO.StartDate.Value.Year, CreateExamDTO.StartDate.Value.Month, CreateExamDTO.StartDate.Value.Day, StartTimeHour, StartTimeMinute, 1);
            CreateExamDTO.EndDate = new DateTime(CreateExamDTO.EndDate.Value.Year, CreateExamDTO.EndDate.Value.Month, CreateExamDTO.EndDate.Value.Day, EndTimeHour, EndTimeMinute, 1);
            await AddAsync();
        }
    }
    private async Task AddAsync()
    {
        var result = await _examServices.AddExamAsync(CreateExamDTO);
        if(!result.IsSuccess)
        {
            SetErrors(result.Errors);
            StateHasChanged();
        }
        else
        {
            _navigationManager.NavigateTo($"Exams/{ClassId}");
        }
    }
}
