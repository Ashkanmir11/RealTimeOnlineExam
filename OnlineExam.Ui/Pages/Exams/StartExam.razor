@using OnlineExam.Ui.Components.Exam;
@using OnlineExam.Ui.DTO.Question
@using OnlineExam.Ui.DTO.TrueOrFalseAnswers

@page "/StartExam/{examId:int}";
@inject ExamServices _examServices;
<ExamStatusComponent ExamId="@ExamId" afterConnect="@SaveChangeAfterConnect"></ExamStatusComponent>
<h3>StartExam</h3>
@{
    if (result == null || result.Data.Count == 0)
    {
        <p>سوالی موجود نیست.</p>
    }
    foreach (var question in result.Data)
    {
        <div style="border:2px solid black">
            @{
                <p>@question.QuestionText</p>
                <p>@question.TotalScore</p>
                if (question.TrueOrFalseQuestion != null)
                {
                    <label>پاسخ:</label>
                    <InputCheckbox @bind-Value:after="()=>UpdateTrueOrFalseAnswer(question.Id)" @bind-Value="@question.TrueOrFalseAnswer.StudentAnswer"></InputCheckbox>
                }
            }
        </div>

    }
}

<ErrorComponent Errors="@Errors"></ErrorComponent>
@code {
    [Parameter]
    public int ExamId { get; set; }
    PaginateResponse<GetQuestionStudentDTO> result = new PaginateResponse<GetQuestionStudentDTO>();
    protected override async Task OnInitializedAsync()
    {
        await GetData();
        await base.OnInitializedAsync();
    }
    private async Task GetData()
    {
        result.Data = new List<GetQuestionStudentDTO>();
        var response = await _examServices.StartExam(ExamId, GetDefultPaginate());
        if (!response.IsSuccess)
        {
            SetErrors(response.Errors);
        }
        else if (response.StatusCode != 204)
        {
            foreach (var question in response.Data.Data)
            {
                if (question.TrueOrFalseQuestion != null)
                {
                    question.TrueOrFalseAnswer = new GetTrueOrFalseAnswerStudentDTO();
                    var answer = await GetMyTrueOrFlaseAnswer(question.Id);
                    if (answer != null)
                    {
                        question.TrueOrFalseAnswer = answer;
                    }
                }
                result.Data.Add(question);
            }
        }
        StateHasChanged();
    }
    private async Task SaveChangeAfterConnect()
    {
        Console.WriteLine("hi");
        foreach(var item in result.Data)
        {
            if(item.TrueOrFalseQuestion!=null)
            {
                Console.WriteLine("hello");

                await UpdateTrueOrFalseAnswer(item.Id);
            }
        }
    }
    private async Task<GetTrueOrFalseAnswerStudentDTO> GetMyTrueOrFlaseAnswer(int questionId)
    {
        var answerResult = await _examServices.GetMyTrueOrFalseAnswer(questionId);
        if (answerResult.IsSuccess != false || answerResult.StatusCode != 204)
        {
            return answerResult.Data;
        }
        else
        {
            return null;
        }

    }
    private async Task UpdateTrueOrFalseAnswer(int questionId)
    {
        var answer = await GetMyTrueOrFlaseAnswer(questionId);
        if (answer == null)
        {
            //add answer
            var newAnswer = new CreateTrueOrFalseAnswerDTO()
                {
                    ExamId = ExamId,
                    StudentAnswer = result.Data.Where(e => e.Id == questionId).Select(e => e.TrueOrFalseAnswer.StudentAnswer).FirstOrDefault(),
                    TrueOrFalseQuestionId = questionId
                };
            var response = await _examServices.CreateTrueOrFalseAnswer(newAnswer);
            if (!response.IsSuccess)
            {
                SetErrors(response.Errors);
            }
            else
            {
                await _jsRuntime.InvokeVoidAsync("alert", "پاسخ ذخیره شد.");
            }
        }
        else
        {
            //Update answer
            var newAnswer = new UpdateTrueOrFalseAnswerDTO()
                {
                    ExamId = ExamId,
                    StudentAnswer = result.Data.Where(e => e.Id == questionId).Select(e => e.TrueOrFalseAnswer.StudentAnswer).FirstOrDefault()
                };
            var response = await _examServices.UpdateTrueOrFalseAnswer(answer.Id, newAnswer);
            if (!response.IsSuccess)
            {
                SetErrors(response.Errors);
            }
            else
            {
                await _jsRuntime.InvokeVoidAsync("alert", "پاسخ ذخیره شد.");
            }

        }
    }



}

