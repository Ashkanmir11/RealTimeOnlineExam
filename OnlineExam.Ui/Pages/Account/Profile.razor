@page "/profile"
<h3>Profile</h3>
<div>
    <p>نام: @Result.FirstName  @Result.LastName</p>
    <p>نام کاربری: @Result.UserName</p>
    <p>شماره تلفن : @Result.Phone</p>
    <p>ایمیل : @Result.Email</p>
</div>
@code {
    MyInfoDTO Result = new MyInfoDTO();
    protected override async Task OnInitializedAsync()
    {
        var response = await _authServices.GetMyInfo();
        if (response.IsSuccess)
        {
            Result = response.Data;
        }
        if (response.StatusCode == 401)
        {
            _navigationManager.NavigateTo("/login");
        }
        await base.OnInitializedAsync();
    }
}
