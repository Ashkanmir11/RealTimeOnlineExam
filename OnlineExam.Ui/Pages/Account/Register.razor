@page "/register"
<h3>Register</h3>
<p>@massage</p>
<EditForm EditContext="@editContext" OnValidSubmit="CreateUser">
    <DataAnnotationsValidator></DataAnnotationsValidator>
    <InputText @bind-Value="@registerDTO.FirstName" placeholder="نام"></InputText>
    <InputText @bind-Value="@registerDTO.LastName" placeholder="نام خانوادگی"></InputText>
    <InputText @bind-Value="@registerDTO.Email" placeholder="ایمیل"></InputText>
    <InputText type="password" @bind-Value="@registerDTO.Password" placeholder="رمز عبور" />
    <InputText type="password" @bind-Value="@registerDTO.ConfirmPassword" placeholder="تکرار رمز عبور" />
    <InputText @bind-Value="@registerDTO.PhoneNumber" placeholder="شماره تلفن" />
    <button type="submit">ثبت نام</button>

</EditForm>
<ErrorComponent Errors="@Errors"></ErrorComponent>
@code {
    private EditContext editContext;
    string massage="";
    private RegisterDTO registerDTO { get; set; } = new RegisterDTO();

    protected override void OnInitialized()
    {
        editContext = new EditContext(registerDTO);
        editContext.OnValidationStateChanged += (sender, args) =>
        {
            var validationErrors = editContext.GetValidationMessages();
            SetErrors(validationErrors.ToList());
            StateHasChanged();
        };
        base.OnInitialized();
    }
    public async Task CreateUser()
    {
        var result = await _authServices.Register(registerDTO);
        Console.WriteLine(result);
        if (result.IsSuccess)
        {
            massage = "ثبت نام با موفقیت انجام شد به صفحه ورود هدایت میشوید.";
            StateHasChanged();
            await Task.Delay(5000);
            _navigationManager.NavigateTo("login");
        }
        else
        {
            SetErrors(result.Errors);
        }
    }
}
