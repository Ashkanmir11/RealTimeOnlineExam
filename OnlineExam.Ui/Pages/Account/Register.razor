@page "/register"
<h3>Register</h3>
<EditForm Model="@registerDTO" OnValidSubmit="CreateUser">
    <DataAnnotationsValidator></DataAnnotationsValidator>
    <ValidationSummary></ValidationSummary>
    <InputText @bind-Value="@registerDTO.FirstName" placeholder="نام"></InputText>
    <InputText @bind-Value="@registerDTO.LastName" placeholder="نام خانوادگی"></InputText>
    <InputText @bind-Value="@registerDTO.Email" placeholder="ایمیل"></InputText>
    <InputText type="password" @bind-Value="@registerDTO.Password" placeholder="رمز عبور" />
    <InputText type="password" @bind-Value="@registerDTO.ConfirmPassword" placeholder="تکرار رمز عبور" />
    <InputText @bind-Value="@registerDTO.PhoneNumber" placeholder="شماره تلفن" />
    <button type="submit">ثبت نام</button>

</EditForm>

<h1>@name</h1>
@code {
    string name = "";
    private RegisterDTO registerDTO { get; set; } = new RegisterDTO();
    public async Task CreateUser()
    {
        name = "shod";
    }
}
