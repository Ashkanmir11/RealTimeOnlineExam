@page "/CreateClassRoom";
@using OnlineExam.Ui.DTO.ClassRoom;
@inject ClassRoomServices _classRoomServices;
@layout ManagmentLayout;

<h1>ثبت کلاس جدید</h1>

<EditForm EditContext="@editContext" OnValidSubmit="@CraeteClassRoom">
    <DataAnnotationsValidator></DataAnnotationsValidator>
    <InputText @bind-Value="@createClassRoomDTO.ClassName"></InputText>
    <button type="submit">افزودن</button>
</EditForm>

<ErrorComponent Errors="Errors"></ErrorComponent>

@code {
    private EditContext editContext;
    CreateClassRoomDTO createClassRoomDTO = new CreateClassRoomDTO();

    protected override void OnInitialized()
    {
        editContext = new EditContext(createClassRoomDTO);
        editContext.OnValidationStateChanged += (sender, args) =>
        {
            var validationErrors = editContext.GetValidationMessages();
            SetErrors(validationErrors.ToList());
            StateHasChanged();
        };
        base.OnInitialized();
    }
    private async Task CraeteClassRoom()
    {

        var result = await _classRoomServices.CreateAsync(createClassRoomDTO);
        if (!result.IsSuccess)
        {
            SetErrors(result.Errors);
        }
        else
        {
            _navigationManager.NavigateTo("classroom");
        }
    }
}

