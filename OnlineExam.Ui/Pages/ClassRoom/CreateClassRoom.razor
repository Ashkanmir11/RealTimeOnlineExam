@page "/CreateClassRoom";
@using OnlineExam.Ui.DTO.ClassRoom;
@inject ClassRoomServices _classRoomServices;
<div class="create-class-page">
    <h1>ثبت کلاس جدید</h1>
    <EditForm EditContext="@EditContext" OnValidSubmit="@CraeteClassRoom">
        <DataAnnotationsValidator />

        <div class="class-form-row">
            <InputText id="className"
                       class="class-name-input"
                       @bind-Value="@CreateClassRoomDTO.ClassName"
                       placeholder="نام کلاس را وارد کنید"
                       autocomplete="off" />

            <button class="submit-button" type="submit">
                <svg class="button-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="12" y1="5" x2="12" y2="19"></line>
                    <line x1="5" y1="12" x2="19" y2="12"></line>
                </svg>
                <span>افزودن کلاس</span>
            </button>
        </div>
    </EditForm>

    <ErrorComponent Errors="Errors" />
</div>





@code {
    private EditContext EditContext;
    CreateClassRoomDTO CreateClassRoomDTO = new CreateClassRoomDTO();

    protected override void OnInitialized()
    {
        EditContext = new EditContext(CreateClassRoomDTO);
        EditContext.OnValidationStateChanged += (sender, args) =>
        {
            var validationErrors = EditContext.GetValidationMessages();
            SetErrors(validationErrors.ToList());
            StateHasChanged();
        };
        base.OnInitialized();
    }
    private async Task CraeteClassRoom()
    {

        var result = await _classRoomServices.CreateAsync(CreateClassRoomDTO);
        if (!result.IsSuccess)
        {
            SetErrors(result.Errors);
        }
        else
        {
            _navigationManager.NavigateTo("classroom");
        }
    }
}

