@using OnlineExam.Ui.DTO.ClassRoom;
@page "/StudentClassRoom"
@inject ClassRoomServices _classRoomServices;
<h3>StudentClassRoom</h3>
<div>
    @{
        if (DataLoaded)
        {
            if (Result == null || Result.Data.Count == 0)
            {
                <p>کلاسی موجود نیست.</p>
            }
            else
            {
                @foreach (var classRoom in Result.Data)
                {
                    <div>
                        <p>@classRoom.ClassName</p>
                        <button @onclick="()=>RedirectToStudentExams(classRoom.Id)">مشاهده آزمون ها</button>
                    </div>
                }
            }
        }
        else
        {
            <LoadingComponent></LoadingComponent>
        }
    }
</div>
<ErrorComponent Errors="@Errors"></ErrorComponent>
<PaginateComponent TotalPage="Result.TotalPage" CurrentPage="Result.PageNumber" SelectedPage="@ChangePage"></PaginateComponent>

@code {
    PaginateResponse<GetClassRoomStudentDTO> Result = new PaginateResponse<GetClassRoomStudentDTO>();
    protected override async Task OnInitializedAsync()
    {
        await GetData();
        await base.OnInitializedAsync();
    }
    private async Task GetData()
    {
        Result.Data = new List<GetClassRoomStudentDTO>();
        var response = await _classRoomServices.GetStudentClasses(GetDefultPaginate());
        DataLoaded = true;
        if (response.IsSuccess && response.StatusCode != 204)
        {
            Result = response.Data;
        }
        else if (!response.IsSuccess)
        {
            SetErrors(response.Errors);
        }
        StateHasChanged();
    }
    private async Task ChangePage(int selectedPage)
    {
        SetPageNumber(selectedPage);
        await GetData();
    }
    private void RedirectToStudentExams(int classId)
    {
        _navigationManager.NavigateTo($"StudentExams/{classId}");
    }
}
