@using OnlineExam.Ui.DTO.ClassRoom;
@page "/classroom";
@inject ClassRoomServices _classRoomServices;
@layout ManagmentLayout;
<h3>ClassRooms</h3>
@{
    <button @onclick="@AddClass">افزودن کلاس.</button>
    //show data
    if (result.Data.Count == 0)
    {
        <div>کلاسی یافت نشد.</div>
    }

    else
    {
        <ErrorComponent Errors="@errors"></ErrorComponent>
        foreach (var classRoom in result.Data)
        {
            <div>
                <p>
                    @classRoom.ClassName
                    <button @onclick="()=> DeleteClassRoom(classRoom.Id)"> حذف</button>
                    <button @onclick="()=>UpdateClass(classRoom.Id)">ویرایش</button>
                </p>
            </div>
        }
    }


}

@code {
    List<string> errors = new List<string>();
    PaginateResponse<GetClassRoomTeacherDTO> result = new PaginateResponse<GetClassRoomTeacherDTO>();


    protected override async Task OnInitializedAsync()
    {
        await GetData();
        await base.OnInitializedAsync();
    }

    private  void AddClass()
    {
        _navigationManager.NavigateTo("CreateClassRoom");
    }
    private  void UpdateClass(int Id)
    {
        _navigationManager.NavigateTo($"updateclassroom/{Id}");
    }
    private async Task DeleteClassRoom(int id)
    {
        var result = await _classRoomServices.DeleteAsync(id);
        if (!result.IsSuccess)
        {
            errors.Clear();
            errors.AddRange(result.Errors);
        }
        else
        {
            await GetData();
        }
    }

    private async Task GetData()
    {
        result.Data = new List<GetClassRoomTeacherDTO>();
        var paginateOption = new PaginateRequestDTO()
            {
                PageNumber = 1,
                PageCount = 10
            };

        var response = await _classRoomServices.GetMyClassAsTeacherAsync(paginateOption);
        if (response.IsSuccess && response.Data.Data.Count > 0)
        {
            result = response.Data;
        }
        StateHasChanged();
    }
}
