@using OnlineExam.Ui.DTO.ClassRoom;
@page "/classroom";
@inject ClassRoomServices _classRoomServices;
@layout ManagmentLayout;
<h3>ClassRooms</h3>
@{
    <button @onclick="@AddClass">افزودن کلاس.</button>
    //show data
    if (result.Data.Count == 0)
    {
        <div>کلاسی یافت نشد.</div>
    }

    else
    {
        <ErrorComponent Errors="@Errors"></ErrorComponent>
        foreach (var classRoom in result.Data)
        {
            <div>
                <p>
                    @classRoom.ClassName
                    <button @onclick="()=>DeleteClassRoom(classRoom.Id)"> حذف</button>
                    <button @onclick="()=>UpdateClass(classRoom.Id)">ویرایش</button>
                    <button @onclick="()=>ManageStudents(classRoom.Id)">مدیریت اعضا</button>
                    <button @onclick="()=>ManageExams(classRoom.Id)">مدیریت آزمون ها</button>
                </p>
            </div>
        }
    }

    <PaginateComponent SelectedPage="@changePage" TotalPage="@totalPage" CurrentPage="@currentPage"></PaginateComponent>
}

@code {
    PaginateResponse<GetClassRoomTeacherDTO> result = new PaginateResponse<GetClassRoomTeacherDTO>();
    PaginateRequestDTO paginateRequestDTO = new PaginateRequestDTO();
    int totalPage;
    int currentPage;

    protected override async Task OnInitializedAsync()
    {
        currentPage = 1;
        await GetData();
        await base.OnInitializedAsync();
    }
    #region Redirect merhods
    private void AddClass()
    {
        _navigationManager.NavigateTo("CreateClassRoom");
    }
    private void UpdateClass(int id)
    {
        _navigationManager.NavigateTo($"updateclassroom/{id}");
    }
    private void ManageStudents(int id)
    {
        _navigationManager.NavigateTo($"classRoomMember/{id}");
    }
    private void ManageExams(int id)
    {
        _navigationManager.NavigateTo($"Exams/{id}");
    }
    #endregion

    private async Task DeleteClassRoom(int id)
    {
        var result = await _classRoomServices.DeleteAsync(id);
        if (!result.IsSuccess)
        {
            SetErrors(result.Errors);
        }
        else
        {
            await GetData();
        }
    }

    private async void changePage(int selectedPage)
    {
        paginateRequestDTO.PageNumber = selectedPage;
        currentPage = selectedPage;
        StateHasChanged();
        await GetData();
    }

    private async Task GetData()
    {
        result.Data = new List<GetClassRoomTeacherDTO>();
        var response = await _classRoomServices.GetMyClassAsTeacherAsync(paginateRequestDTO);
        if (response.IsSuccess && response.StatusCode != 204)
        {
            totalPage = response.Data.TotalPage;
            result = response.Data;
        }
        else if (!response.IsSuccess)
        {
            SetErrors(response.Errors);
        }
        StateHasChanged();
    }

}
