@page "/classRoomMember/{ClassId:int}"
@using OnlineExam.Ui.DTO.ClassRoomMembers;
@using OnlineExam.Ui.Components.ClassRoomMembers;
@inject ClassRoomMemberServices _classRoomMembersServices;
<h3>مدیریت اعضای کلاس</h3>
@{
    <h4>@GetClassRoomMembersDTO.className</h4>
    if (ShowCreateMember)
    {
        <button @onclick="@ChangeShowCreateStatus">بستن</button>
        <AddClassRoomMemberComponent SuccessAdd="AddComplete" ClassId="@ClassId"></AddClassRoomMemberComponent>
    }
    else
    {
        <button @onclick="@ChangeShowCreateStatus">افزودن اعضا</button>

    }
    if (GetClassRoomMembersDTO.students != null && GetClassRoomMembersDTO.students.Count > 0)
    {

        <table>
            <tr>
                <th>نام کاربری</th>
                <th>نام و نام خانوادگی</th>
                <th>شماره موبایل</th>
                <th>ایمیل</th>
                <th>عملیات</th>
            </tr>
            @foreach (var student in GetClassRoomMembersDTO.students)
            {
                <tr>
                    <td>@student.UserName</td>
                    <td>@student.FirstName @student.LastName</td>
                    <td>@student.Phone</td>
                    <td>@student.Email</td>
                    <td>
                        <button @onclick="()=>DeleteMember(student.Id)">حذف</button>
                    </td>
                </tr>
            }
        </table>

    }
    else
    {
        <p>کلاس عضوی ندارد.</p>
    }
    <ErrorComponent Errors="Errors"></ErrorComponent>
}

@code {
    [Parameter]
    public int ClassId { get; set; }
    bool ShowCreateMember = false;
    private GetClassRoomMembersDTO GetClassRoomMembersDTO = new GetClassRoomMembersDTO();

    private void ChangeShowCreateStatus()
    {
        ShowCreateMember = ShowCreateMember == true ? false : true;
    }
    private async Task AddComplete()
    {
        ChangeShowCreateStatus();
        await GetData();
    }
    protected override async Task OnInitializedAsync()
    {
        await GetData();
        await base.OnInitializedAsync();
    }
    private async Task DeleteMember(string studentId)
    {
        var result = await _classRoomMembersServices.DeleteMember(studentId, ClassId);
        if (!result.IsSuccess)
        {
            SetErrors(result.Errors);
        }
        else
        {
            await GetData();
        }
    }
    private async Task GetData()
    {
        var classMembers = await _classRoomMembersServices.GetClassStudnets(ClassId);

        if (!classMembers.IsSuccess)
        {
            SetErrors(classMembers.Errors);
        }
        else if (classMembers.StatusCode != 204)
        {
            GetClassRoomMembersDTO.students = new List<StudentsInfoDTO>();
            Console.WriteLine(GetClassRoomMembersDTO.students.Count);
            GetClassRoomMembersDTO = classMembers.Data;
        }
    }
}
