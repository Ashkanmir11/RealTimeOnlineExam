<div>
    <ul>
        @{
            if (!isUserLogin)
            {
                <li>
                    <a href="register">
                        ثبت نام
                    </a>
                </li>
                <li>
                    <a href="login">
                        ورود
                    </a>
                </li>
            }
            else
            {
                <li>
                    <a href="profile">
                        مشاهده پروفایل
                    </a>
                </li>
                <li>
                    <a style="" @onclick="@Logout">
                        خروج از حساب
                    </a>
                </li>
            }
        }
    </ul>
</div>
@code {
    bool isUserLogin;

    protected override async Task OnInitializedAsync()
    {
        isUserLogin = await _authServices.IsUserLogin();
        await base.OnInitializedAsync();
    }
    private async Task Logout()
    {
        isUserLogin = false;
        await _authServices.Logout();
        _navigationManager.NavigateTo("");

    }

}
